# Copy to .env.local. Values are read at launch, never bundled in the app.
# Use your own OpenAI key with access to GPT-6 Astra.
OPENAI_API_KEY=
DASH_REASONING_EFFORT=low
# Optional API proxy; defaults to https://api.openai.com/v1.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Supporting speech service. See docs/SPEECH.md.
DASH_ASR_URL=http://127.0.0.1:8001
DASH_ASR_API_KEY=
# Optional: save full document/model diagnostics to a LOCAL directory.
# EDITOR_EVIDENCE_DIR=/absolute/path/to/private-diagnostics
